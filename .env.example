# ─────────────────────────────────────────────────────────────
# AITZAZ AI 2070 — environment variables
# ─────────────────────────────────────────────────────────────
# COPY this file to `.env.local` and fill in REAL values there.
# .env.local is ignored by git — secrets NEVER go into the repo.

# ── AI Provider (Phase 2 — server-side only) ──
# Choose ONE provider. Set its key below. Never expose keys to the browser.
AI_PROVIDER=openai            # openai | anthropic | custom

# Option A — OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option B — Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Option C — Custom OpenAI-compatible endpoint (oMLX, LM Studio, vLLM, llama.cpp, LocalAI…)
# CUSTOM_AI_BASE_URL=http://127.0.0.1:1234/v1
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_MODEL=

# ── Database (Phase 3+ — Supabase/PostgreSQL) ──
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── App ──
# APP_URL=http://localhost:3000
